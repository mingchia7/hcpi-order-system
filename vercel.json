{
  "rewrites": [
    { "source": "/operator-report.html", "destination": "/operator-report.html" },
    { "source": "/inspection.html", "destination": "/inspection.html" },
    { "source": "/app.html", "destination": "/app.html" },
    { "source": "/", "destination": "/hcpi-order-tracker.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
